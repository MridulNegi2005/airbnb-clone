# Copy this file to .env and replace the values.
DATABASE_URL=sqlite:///./airbnb.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000"]
SERVICE_FEE_RATE=0.14

# Image storage: "local" serves files from LOCAL_MEDIA_DIR at /media; "gcs" uses a bucket.
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=media
PUBLIC_BASE_URL=http://localhost:8000
GCS_BUCKET=
# Path to a service-account JSON key. Leave empty to use Application Default Credentials.
GCS_CREDENTIALS_FILE=
MAX_UPLOAD_BYTES=8388608
MAX_UPLOADS_PER_USER=300

# OAuth 2.0 web client ID for "Continue with Google". Leave empty to disable it.
GOOGLE_CLIENT_ID=

# Requests per minute per client IP across the whole API.
RATE_LIMIT_PER_MINUTE=300

# Password given to every seeded demo user.
SEED_USER_PASSWORD=replace-with-a-demo-password
