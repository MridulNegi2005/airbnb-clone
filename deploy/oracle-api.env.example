# Copy privately to /opt/airbnb-clone/backend/.env and chmod 600.
# Generate a fresh production key; do not reuse a local development JWT key.
SECRET_KEY=
SEED_USER_PASSWORD=
ACCESS_TOKEN_TTL_MINUTES=10080
CORS_ORIGINS=["https://airbnb.mridulnegi.dev"]
PUBLIC_BASE_URL=https://airbnb-api.mridulnegi.dev
SERVICE_FEE_RATE=0.14
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=/app/data/media
MAX_UPLOAD_BYTES=8388608
MAX_UPLOADS_PER_USER=300
RATE_LIMIT_PER_MINUTE=300

# Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID when Google sign-in is enabled.
GOOGLE_CLIENT_ID=

# Optional GCS override requires a public-read bucket and a private service-account file.
GCS_BUCKET=airbnb-clone-mridul-media
GCS_CREDENTIALS_FILE=/run/secrets/gcs-service-account.json
