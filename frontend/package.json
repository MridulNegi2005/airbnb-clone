{
  "name": "airbnb-clone-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run cf-typegen",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "npm run cf-typegen",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "node --test scripts/patch-preview-manifest.test.mjs && node scripts/cloudflare.mjs build",
    "verify:deployment": "node scripts/check-deployment.mjs",
    "preview": "node scripts/cloudflare.mjs preview",
    "deploy": "node scripts/cloudflare.mjs deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-query": "^5.90.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-day-picker": "^9.11.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.148.0"
  }
}
